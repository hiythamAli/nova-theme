{% extends "layouts.master" %}
{% set robots_directive = 'noindex, nofollow' %}

{% block content %}
    <div class="nova-container nova-section">
        <h1 class="nova-listing-heading">{{ trans('order.my_orders') }}</h1>

        <div class="nova-orders-list">
            {% for order in orders %}
                <a href="{{ order.url | default('#') }}" class="nova-orders-list__item">
                    <div>
                        <span class="nova-orders-list__reference">
                            {{ trans('order.reference') }}: {{ order.reference_id | default(order.id) }}
                        </span>
                        <span class="nova-text-xs" style="color: var(--nova-color-text-light)">
                            {{ order.created_at }}
                        </span>
                    </div>
                    <span class="nova-badge nova-badge--outline">{{ order.status }}</span>
                    <span class="nova-orders-list__total">{{ order.total | money }}</span>
                </a>
            {% else %}
                <p class="nova-listing__empty">{{ trans('order.no_orders') }}</p>
            {% endfor %}
        </div>

        {% include 'partials/product/pagination.twig' %}
    </div>
{% endblock %}
