{% extends "layouts.master" %}

{% block content %}
    <div class="nova-container nova-section">
        <h1 class="nova-listing-heading">{{ trans('brand.all_brands') }}</h1>

        <div class="nova-grid">
            {% for brand in brands %}
                <div class="nova-col-6 nova-col-tablet-3 nova-col-desktop-2">
                    {% include 'partials/brand/card.twig' %}
                </div>
            {% endfor %}
        </div>

        {% include 'partials/product/pagination.twig' %}
    </div>
{% endblock %}
