{#
    NOVA Cart — src/views/pages/cart.twig
    Built directly against SallaApp/theme-raed's official cart.twig
    (github.com/SallaApp/theme-raed/blob/master/src/views/pages/cart.twig),
    which includes a full confirmed variable table. Confirmed: cart.items[]
    (.id, .url, .quantity, .product_name, .product_image, .price, .total,
    .total_special_price, .is_available, .max_quantity, .detailed_offers,
    .offer), cart.free_shipping_bar (.percent, .remaining,
    .has_free_shipping), cart.options[]. Confirmed hooks:
    cart:items.start/end, cart:summary.start/end, cart:coupon.start/end,
    cart:summary-card.start/end. Confirmed API calls:
    salla.form.onChange('cart.updateItem', event), salla.cart.deleteItem(id).
    NOVA markup/classes replace theme-raed's Tailwind classes; component
    and hook names are kept exactly as confirmed.
#}

{% extends "layouts.master" %}
{% set robots_directive = 'noindex, nofollow' %}

{% block content %}
<div class="nova-container nova-cart">

    <h1 class="nova-cart__title">{{ trans('blocks.header.cart') }}</h1>

    <salla-conditional-offer></salla-conditional-offer>

    <div class="nova-cart__layout">
        <div class="nova-cart__items">
            {% hook 'cart:items.start' %}

            {% for item in cart.items %}
                <form onchange="salla.form.onChange('cart.updateItem', event)" id="item-{{ item.id }}">
                    <section class="nova-cart-item">
                        <input type="hidden" name="id" value="{{ item.id }}">

                        <a href="{{ item.url }}" class="nova-cart-item__media">
                            <img
                                src="{{ item.product_image }}"
                                alt="{{ item.product_name }}"
                                loading="{{ loop.first ? 'eager' : 'lazy' }}"
                            >
                        </a>

                        <div class="nova-cart-item__info">
                            <a href="{{ item.url }}" class="nova-cart-item__name">{{ item.product_name }}</a>

                            <span class="nova-price__regular{{ item.has_discount ? '' : ' nova-price__regular--only' }}">
                                {{ item.price | money }}
                            </span>

                            {% if item.offer %}
                                <span class="nova-badge nova-badge--accent">{{ item.offer.names }}</span>
                            {% endif %}

                            <salla-cart-item-offers
                                quantity="{{ item.quantity }}"
                                item-id="{{ item.id }}"
                                product-price="{{ item.product_price }}"
                                offers="{{ item.detailed_offers | json_encode }}"
                            ></salla-cart-item-offers>

                            {% include 'partials/product/options.twig' with { product: item } %}
                        </div>

                        <div class="nova-cart-item__actions">
                            {% if item.is_hidden_quantity %}
                                <input type="hidden" value="{{ item.quantity }}" name="quantity">
                                <span class="nova-cart-item__qty-static">{{ item.quantity }}</span>
                            {% else %}
                                <salla-quantity-input
                                    cart-item-id="{{ item.id }}"
                                    max="{{ item.max_quantity }}"
                                    value="{{ item.quantity }}"
                                    name="quantity"
                                    class="nova-quantity-input"
                                ></salla-quantity-input>
                            {% endif %}

                            <p class="nova-cart-item__total">
                                <span>{{ trans('pages.cart.total') }}:</span>
                                {% set item_total = item.detailed_offers | length > 0 ? item.total_special_price | money : item.total | money %}
                                <span>{{ item.is_available ? item_total : trans('pages.cart.out_of_stock') }}</span>
                            </p>
                        </div>

                        <salla-button
                            shape="icon"
                            size="small"
                            color="danger"
                            class="nova-cart-item__delete"
                            aria-label="{{ trans('cart.remove_item') }}"
                            onclick="salla.cart.deleteItem('{{ item.id }}').then(() => document.querySelector('#item-{{ item.id }}').remove())"
                        >
                            <i class="sicon-cancel" aria-hidden="true"></i>
                        </salla-button>
                    </section>
                </form>
            {% else %}
                <div class="nova-cart__empty">
                    <i class="sicon-shopping-bag" aria-hidden="true"></i>
                    <p>{{ trans('pages.cart.empty_cart') }}</p>
                    <a href="{{ link('/') }}" class="nova-btn nova-btn--outline">{{ trans('common.elements.back_home') }}</a>
                </div>
            {% endfor %}

            {% if cart.options | length %}
                <div class="nova-cart-options">
                    {% for product_option in cart.options %}
                        <form onchange="salla.form.onChange('cart.updateItem', event)" id="item-{{ product_option.id }}">
                            <input type="hidden" name="id" value="{{ product_option.id }}">
                            <input type="hidden" name="quantity" value="{{ product_option.quantity }}">
                            {% include 'partials/product/options.twig' with { product: product_option } %}
                        </form>
                    {% endfor %}
                </div>
            {% endif %}

            <salla-offer></salla-offer>

            {% hook 'cart:items.end' %}
        </div>

        {% hook 'cart:summary.start' %}

        {% if cart.items | length %}
            <aside class="nova-cart__sidebar">
                {% if cart.free_shipping_bar and theme.settings.get('cart_show_free_shipping_bar') %}
                    <div class="nova-cart-shipping-bar">
                        <div class="nova-cart-shipping-bar__header">
                            <i class="sicon-shipping-fast" aria-hidden="true"></i>
                            <div>
                                <h4>{{ trans('pages.cart.free_shipping') }}</h4>
                                <p>
                                    {{ (cart.free_shipping_bar.has_free_shipping
                                        ? trans('pages.cart.has_free_shipping')
                                        : trans('pages.cart.free_shipping_alert', { amount: cart.free_shipping_bar.remaining | money })
                                    ) | raw }}
                                </p>
                            </div>
                        </div>
                        {% if not cart.free_shipping_bar.has_free_shipping %}
                            <div class="nova-cart-shipping-bar__track">
                                <div class="nova-cart-shipping-bar__fill" style="width: {{ cart.free_shipping_bar.percent }}%"></div>
                            </div>
                        {% endif %}
                    </div>
                {% endif %}

                {% if store.settings.cart.apply_coupon_enabled and theme.settings.get('cart_show_coupon_field') %}
                    <div class="nova-cart-card">
                        {% hook 'cart:coupon.start' %}
                        <salla-cart-coupons></salla-cart-coupons>
                        {% hook 'cart:coupon.end' %}
                    </div>
                {% endif %}

                {% hook 'cart:summary-card.start' %}
                <salla-cart-summary-card></salla-cart-summary-card>
                {% hook 'cart:summary-card.end' %}
            </aside>
        {% endif %}

        {% hook 'cart:summary.end' %}
    </div>
</div>
{% endblock %}

{#
    No page-specific script needed: the confirmed cart web components
    (salla-cart-summary-card, salla-cart-coupons, salla-quantity-input,
    etc.) self-initialize via the Twilight SDK once salla.init() runs at
    {% hook 'body:end' %} in master.twig. An earlier draft shipped an
    empty checkout.js purely to mirror theme-raed's reference — removed
    since shipping an empty file has no benefit.
#}
