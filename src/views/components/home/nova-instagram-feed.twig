{#
    NOVA Instagram Feed — src/views/components/home/nova-instagram-feed.twig
    Custom Theme Component. Static merchant-uploaded images (no live
    Instagram API integration — that would need a verified Salla or
    Instagram Graph API integration not covered by any doc consulted so
    far; flagged rather than guessed at).
#}

<section class="nova-section nova-instagram">
    <div class="nova-container">
        {% if component.title %}
            <h2 class="nova-section__title">{{ component.title }}</h2>
        {% endif %}

        <div class="nova-grid nova-instagram__grid">
            {% for post in component.posts %}
                <a
                    href="{{ post.url }}"
                    target="_blank"
                    rel="noopener"
                    class="nova-col-3 nova-instagram__post"
                >
                    <img src="{{ post.image }}" alt="" loading="lazy">
                    <span class="nova-instagram__icon">
                        <i class="sicon-instagram" aria-hidden="true"></i>
                    </span>
                </a>
            {% endfor %}
        </div>

        {% if component.profile_url %}
            <a href="{{ component.profile_url }}" target="_blank" rel="noopener" class="nova-instagram__follow">
                {{ trans('common.follow_us_on_instagram') }}
            </a>
        {% endif %}
    </div>
</section>
