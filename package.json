{
  "name": "nova-premium-theme",
  "version": "1.0.0",
  "description": "NOVA — a premium, fully customizable Salla (Twilight) theme for modern brands.",
  "private": true,
  "type": "module",
  "author": "Haytham Ali",
  "license": "UNLICENSED",
  "scripts": {
  "dev": "vite",
  "watch": "vite --host 0.0.0.0",
  "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write \"src/**/*.{ts,scss,json}\"",
    "format:check": "prettier --check \"src/**/*.{ts,scss,json}\"",
    "validate:twig": "node scripts/validate-twig.cjs",
    "validate": "npm run typecheck && npm run lint && npm run format:check && npm run validate:twig && npm run build"
  },
  "dependencies": {},
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "^7.16.0",
    "@typescript-eslint/parser": "^7.16.0",
    "eslint": "^8.57.0",
    "eslint-config-prettier": "^9.1.0",
    "prettier": "^3.3.2",
    "sass": "^1.77.6",
    "twig": "^3.0.0",
    "typescript": "^5.5.3",
    "vite": "^5.3.3",
    "vite-plugin-image-optimizer": "^1.1.8"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
